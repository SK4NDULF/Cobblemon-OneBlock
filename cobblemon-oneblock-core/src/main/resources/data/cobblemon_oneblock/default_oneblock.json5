  // ---------------------------------------------------------------------------------------
  // Treasure chests. A share of breaks regenerates the anchor as a loot chest instead of a
  // plain block, filled from a real chest loot table — the same ones world generation uses.
  //
  // Tables are sorted by dimension from their ids: anything matching a Nether structure goes
  // to the Nether pool, End City to the End pool, everything else to the Overworld. So a
  // Nether anchor gives bastion and fortress loot, and never a village chest.
  //
  // The chance is flat and never scales with island progress. Difficulty scales on this
  // project, rewards do not.
  // ---------------------------------------------------------------------------------------
  "chests": {
    "enabled": true,
    // Share of breaks that produce a chest, as a fraction of 1. 0.02 is about one chest every
    // fifty blocks. Clamped to 0.0-1.0.
    "chance": 0.02,
    // false = only Minecraft's own chest loot tables. true = every "chests/..." table any mod
    // or data pack registered. Modded structure loot can be far outside vanilla balance.
    "include_modded": false,
    // Loot table ids never used, e.g. "minecraft:chests/end_city_treasure".
    "blacklist": [],
    // Tables added to a specific dimension's pool verbatim, whatever their id. Needed because
    // the "chests/..." convention is Minecraft's alone — Cobblemon keeps its structure loot
    // under "cobblemon:ruins/gilded_chests/ruins" and similar, so list those here if you want
    // them. Ids that do not exist are reported in the log and skipped.
    "overworld_extra": [],
    "nether_extra": [],
    "end_extra": [],
  },
}
