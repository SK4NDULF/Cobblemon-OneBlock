/*
 * Where tech points come from.
 *
 * Copied to config/cobblemon_oneblock/points.json5 on first start and never touched again,
 * so your edits always win. Delete it to get this default back. Reload with /ob reload.
 *
 * Points are deliberately NOT paid for mining or for player EXP. In a OneBlock mod, mining is
 * what a player does anyway, so paying for it would just rename the passage of time. Points
 * come from content you have to go and beat.
 *
 * EVERY SOURCE IS CLAIMABLE ONCE PER ISLAND. The first member to beat a trainer banks it for
 * the whole island; the rest are told it is already claimed. That is what keeps a four-person
 * island from progressing four times as fast as a solo one on identical content.
 *
 * Check the startup log: it prints what these advancements are worth in total against what the
 * tech tree costs, so you can see how much your NPC trainers still have to cover.
 */
{
  // ---------------------------------------------------------------------------------------
  // NPC trainers and gyms.
  //
  // Trainers are NOT listed here. Each NPC carries its own id and value as Cobblemon config
  // variables, so adding a gym is placing an entity and typing two commands — no config edit,
  // no reload, no restart:
  //
  //     /npc edit <npc> variable trainer_id gym_rock
  //     /npc edit <npc> variable points 3
  //
  // The id is what the island's claim is stored under, so keep it stable: rebuilding or moving
  // the NPC keeps the progress as long as the id does. An NPC with no trainer_id grants
  // nothing and says so in the log once.
  // ---------------------------------------------------------------------------------------
  "npc": {
    "id_variable": "trainer_id",
    "points_variable": "points",
    // Used when an NPC has a trainer_id but no points variable.
    "default_points": 1,
  },

  // ---------------------------------------------------------------------------------------
  // Advancements.
  //
  // The defaults below are Cobblemon's own, because they are the ones that fit a Cobblemon
  // server: they reward playing with Pokémon rather than mining faster. Vanilla advancement
  // ids work exactly the same way, as do any your data pack adds — this is the file where a
  // server defines its own progression, and replacing this list wholesale is expected.
  //
  // Only advancements completed WHILE THE PLAYER HAS AN ISLAND pay out. Something finished
  // beforehand never fires again. That is deliberate: granting everything already completed
  // when an island is created would make /ob reset an infinite point machine.
  // ---------------------------------------------------------------------------------------
  "advancements": {
    // First steps — cheap, and reachable in the first session.
    "cobblemon:first_catch": 1,
    "cobblemon:first_battle_victory": 1,
    "cobblemon:first_evolution": 1,
    "cobblemon:interact_with_pokemon": 1,
    "cobblemon:craft_poke_ball": 1,
    "cobblemon:harvest_apricorn": 1,
    "cobblemon:obtain_berry": 1,

    // Getting established.
    "cobblemon:full_party": 2,
    "cobblemon:craft_pokedex": 2,
    "cobblemon:healing_machine": 2,
    "cobblemon:craft_base_balls": 2,
    "cobblemon:craft_apricorn_balls": 2,
    "cobblemon:craft_rod": 2,
    "cobblemon:brew_potion": 2,
    "cobblemon:obtain_fossil": 2,
    "cobblemon:place_campfire_pot": 2,
    "cobblemon:cook_snack": 2,
    "cobblemon:harvest_apricorn_seed": 2,
    "cobblemon:obtain_mint": 2,
    "cobblemon:obtain_tumblestone": 2,
    "cobblemon:grow_tumblestone": 2,

    // Real commitment.
    "cobblemon:first_shiny_catch": 5,
    "cobblemon:craft_all_balls": 5,
    "cobblemon:craft_ancient_balls": 5,
    "cobblemon:craft_master_rod": 5,
    "cobblemon:brew_all": 5,
    "cobblemon:brew_full_restore": 4,
    "cobblemon:medicinal_brew": 3,
    "cobblemon:obtain_all_berries": 5,
    "cobblemon:obtain_all_mints": 5,
    "cobblemon:evolve_shedinja": 4,
    "cobblemon:evolve_veevees": 5,
    "cobblemon:evolve_gholdengo_netherite": 5,
    "cobblemon:max_level_baby": 4,
    "cobblemon:max_ride_stats": 4,
    "cobblemon:rainbow_apricorns": 4,
    "cobblemon:cook_all_regional_delicacies": 4,
    "cobblemon:cook_all_ev_mochi": 4,
    "cobblemon:own_zangoose_seviper": 3,
    "cobblemon:obtain_mutated_berry": 3,
    "cobblemon:obtain_revival_herb": 2,
    "cobblemon:obtain_big_root": 2,
    "cobblemon:obtain_leek": 2,
    "cobblemon:any_plant": 2,

    // The long ones.
    "cobblemon:catch_all_vivillon": 10,
  },
}
