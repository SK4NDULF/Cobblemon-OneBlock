      // The payoff tier: things you would otherwise have to craft or go find.
      "5": [
        { "block": "minecraft:bookshelf", "weight": 8 },
        { "block": "minecraft:barrel", "weight": 6 },
        { "block": "minecraft:honeycomb_block", "weight": 5 },
        { "block": "minecraft:beehive", "weight": 3 },
