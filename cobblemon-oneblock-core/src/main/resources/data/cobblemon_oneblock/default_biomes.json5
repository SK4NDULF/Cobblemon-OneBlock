/*
 * OneBlock biome sets — what the block actually produces.
 *
 * Copied to config/cobblemon_oneblock/oneblock_biomes.json5 on first start and never touched
 * again, so your edits always win. Delete it to get this default back. Reload with /ob reload.
 *
 * "base" is what an island with nothing unlocked gets. It is meant to feel poor.
 * "biomes" maps a biome id to its tiers. The tier numbers line up with the "tier" values of
 * the oneblock_biome effects in techtree.json5 — buying Forest rank 3 unlocks forest tiers
 * 1, 2 and 3, and all of them stay in the pool.
 *
 * The base set is never removed. Unlocking more biomes does not replace it, it just makes it
 * a smaller share of the pool, which is why weights matter more than block counts.
 *
 * An entry is either a plain block id (weight 1) or {"block": "...", "weight": N}. Higher
 * weight = more common. Unknown blocks are logged and skipped, so listing a modded block that
 * is not installed is safe.
 *
 * TWO RULES THE SERVER ENFORCES FOR YOU, both logged when they fire:
 *  - a block that cannot stand on its own is dropped. Saplings, torches, flowers, crops, rails
 *    and anything else needing support would pop off the instant it became the anchor.
 *  - an unbreakable block is dropped. Bedrock as the anchor would soft-lock the island.
 *
 * Things worth NOT adding, learned the hard way: ice (melts into water and drains away),
 * powder snow (players fall through it into the void) and dragon eggs (teleport when hit,
 * usually off the island). Lanterns and torches look like solid blocks in a list and are not —
 * the support check catches them, but the log line is the only sign, so read it after editing.
 */
{
  // The starting four. Deliberately dull — this is what buying nothing looks like.
  "base": [
    { "block": "minecraft:grass_block", "weight": 30 },
    { "block": "minecraft:dirt", "weight": 30 },
    { "block": "minecraft:cobblestone", "weight": 25 },
    { "block": "minecraft:oak_planks", "weight": 15 },
  ],

  "biomes": {

    // -----------------------------------------------------------------------------------
    // Forest — wood and everything above ground. The cheapest ladder and the usual first
    // buy, because wood is what a new island has none of.
    // -----------------------------------------------------------------------------------
    "forest": {
      "1": [
        { "block": "minecraft:oak_log", "weight": 30 },
        { "block": "minecraft:oak_leaves", "weight": 24 },
        { "block": "minecraft:stripped_oak_log", "weight": 10 },
        { "block": "minecraft:oak_wood", "weight": 8 },
        { "block": "minecraft:coarse_dirt", "weight": 10 },
        { "block": "minecraft:rooted_dirt", "weight": 8 },
        { "block": "minecraft:moss_block", "weight": 6 },
      ],
      "2": [
        { "block": "minecraft:birch_log", "weight": 20 },
        { "block": "minecraft:birch_leaves", "weight": 16 },
        { "block": "minecraft:spruce_log", "weight": 20 },
        { "block": "minecraft:spruce_leaves", "weight": 16 },
        { "block": "minecraft:podzol", "weight": 10 },
        { "block": "minecraft:mossy_cobblestone", "weight": 8 },
      ],
      "3": [
        { "block": "minecraft:jungle_log", "weight": 18 },
        { "block": "minecraft:jungle_leaves", "weight": 14 },
        { "block": "minecraft:acacia_log", "weight": 16 },
        { "block": "minecraft:acacia_leaves", "weight": 12 },
        { "block": "minecraft:bamboo_block", "weight": 8 },
        { "block": "minecraft:pumpkin", "weight": 6 },
        { "block": "minecraft:melon", "weight": 6 },
      ],
      "4": [
        { "block": "minecraft:cherry_log", "weight": 14 },
        { "block": "minecraft:cherry_leaves", "weight": 12 },
        { "block": "minecraft:mangrove_log", "weight": 12 },
        { "block": "minecraft:mangrove_leaves", "weight": 10 },
        { "block": "minecraft:mangrove_roots", "weight": 8 },
        { "block": "minecraft:muddy_mangrove_roots", "weight": 8 },
        { "block": "minecraft:packed_mud", "weight": 8 },
